# Aesthetic Thumbnails — API Keys
# These keys stay LOCAL on your machine. They are gitignored and never shared.

# Required: Google Gemini API key (free from ai.google.dev)
# Powers thumbnail generation (~$0.134/image) and headshot analysis
GEMINI_API_KEY=

# Optional but recommended: YouTube Data API v3 key (free from Google Cloud Console)
# Powers outlier research — finds high-performing thumbnails in your niche
# Without this, you skip the research phase and go straight to concept design
YOUTUBE_API_KEY=

# Gemini model for image generation (default: gemini-3-pro-image-preview)
# Change this if Google renames or graduates the model
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
